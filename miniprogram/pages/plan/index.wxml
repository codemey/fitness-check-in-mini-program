<view class="page">
  <view class="eyebrow">WEEKLY PLAN</view>
  <view class="heading">训练计划</view>
  <view class="subheading">{{configured ? '每周循环 · ' + effectiveDate + '起' : '尚未设置计划'}}</view>

  <view wx:if="{{loading}}" class="empty">正在读取计划...</view>
  <view wx:elif="{{!loaded}}" class="panel">
    <view class="error">{{error}}</view>
    <button class="button-plain plan-retry" bindtap="load">重试</button>
  </view>
  <view wx:else class="panel plan-panel">
    <view class="section-title">每周安排</view>
    <view wx:for="{{week}}" wx:key="label" class="weekday-block">
      <button class="weekday-row" data-day="{{index}}" bindtap="selectDay">
        <text class="weekday-name">{{item.label}}</text>
        <text class="weekday-summary">{{item.summary}}</text>
        <text class="weekday-chevron">{{editingDay === index ? '⌃' : '›'}}</text>
      </button>
      <view wx:if="{{editingDay === index}}" class="day-editor">
        <view class="day-options">
          <view wx:for="{{item.choices}}" wx:for-item="option" wx:for-index="optionIndex" wx:key="label"
            class="day-option {{option.selected ? 'selected' : ''}} {{option.legacy ? 'legacy' : ''}}"
            aria-role="checkbox" aria-checked="{{option.selected}}"
            data-day="{{index}}" data-part="{{option.label}}" bindtap="togglePart">{{option.label}}</view>
        </view>
        <button class="rest-action" data-day="{{index}}" bindtap="setRest">设为休息日</button>
      </view>
    </view>
    <view class="plan-note">保存后从今天起生效，过去的计划保持不变</view>
    <button class="button-primary plan-save" disabled="{{!dirty || saving}}"
      bindtap="savePlan">{{saving ? '保存中...' : '保存计划'}}</button>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>
</view>
