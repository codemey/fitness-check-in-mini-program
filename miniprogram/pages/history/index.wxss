.view-tabs { display: flex; gap: 12rpx; margin-top: 32rpx; }
.view-tab { flex: 1; min-width: 0; height: 70rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; box-sizing: border-box; line-height: 1.2; border-radius: 8rpx; background: #edf1ef; color: #40514a; font-size: 25rpx; }
.view-tab.selected { background: #176b55; color: #fff; font-weight: 700; }
.history-panel { margin-top: 20rpx; }
.period-bar { display: flex; align-items: center; gap: 12rpx; }
.period-picker { flex: 1; min-width: 0; }
.period-label { height: 68rpx; display: flex; align-items: center; justify-content: center; white-space: nowrap; font-size: 30rpx; font-weight: 700; color: #202a27; }
.period-chevron { margin-left: 10rpx; position: relative; top: -1rpx; font-size: 18rpx; line-height: 1; }
.arrow { flex: 0 0 68rpx; width: 68rpx; height: 68rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; box-sizing: border-box; line-height: 1; background: #eef4f0; color: #176b55; border-radius: 8rpx; font-size: 40rpx; }
.arrow[disabled] { color: #aab5ae; background: #f5f6f5; }
.weekdays, .grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); text-align: center; }
.weekdays { margin-top: 34rpx; color: #77857d; font-size: 23rpx; }
.grid { margin-top: 14rpx; row-gap: 6rpx; }
.day-wrap { min-width: 0; height: 76rpx; display: flex; align-items: center; justify-content: center; }
.day { width: 68rpx; max-width: 100%; height: 68rpx; margin: 0; padding: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5rpx; box-sizing: border-box; line-height: 1; white-space: nowrap; font-size: 26rpx; color: #26332d; border-radius: 8rpx; background: transparent; }
.day.chosen { background: #e8f4ec; color: #176b55; font-weight: 700; }
.day.future { color: #aab5ae; }
.day-number { display: block; white-space: nowrap; }
.dot { flex: 0 0 8rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: #176b55; }
.dot.planned { box-sizing: border-box; border: 2rpx solid #af8250; background: transparent; }
.legend { display: flex; justify-content: center; gap: 26rpx; margin-top: 24rpx; color: #718078; font-size: 21rpx; }
.key { display: inline-block; width: 10rpx; height: 10rpx; border-radius: 50%; vertical-align: middle; margin-right: 8rpx; }
.key.trained { background: #176b55; }
.key.planned { box-sizing: border-box; border: 2rpx solid #af8250; }
.detail-date { font-size: 26rpx; color: #64716c; margin-bottom: 28rpx; }
.detail-plan { display: flex; align-items: baseline; gap: 18rpx; padding-bottom: 20rpx; margin-bottom: 24rpx; border-bottom: 1rpx solid #e5eae6; color: #64716c; font-size: 23rpx; }
.detail-plan text:last-child { flex: 1; min-width: 0; color: #202a27; font-size: 25rpx; overflow-wrap: anywhere; }
.chart-content { margin-top: 30rpx; }
.chart-heading { font-size: 28rpx; font-weight: 700; }
.chart-total { margin-top: 8rpx; margin-bottom: 28rpx; color: #64716c; font-size: 24rpx; }
.part-chart { display: grid; grid-template-columns: max-content minmax(0, 1fr) max-content; grid-auto-rows: 68rpx; align-items: center; column-gap: 16rpx; }
.part-label { white-space: nowrap; text-align: right; font-size: 23rpx; }
.part-track { height: 20rpx; min-width: 0; overflow: hidden; border-radius: 4rpx; background: #edf1ef; }
.part-fill { height: 100%; border-radius: 4rpx; }
.part-0 { background: #176b55; }
.part-1 { background: #497a99; }
.part-2 { background: #af8250; }
.part-3 { background: #bf6b55; }
.part-count { min-width: 32rpx; text-align: right; font-size: 25rpx; font-weight: 700; }
.year-chart { display: flex; gap: 4rpx; border-bottom: 2rpx solid #dce5df; }
.year-column { flex: 1; min-width: 0; height: 224rpx; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
.year-count { height: 28rpx; white-space: nowrap; font-size: 20rpx; color: #44554c; }
.year-bar-area { height: 160rpx; width: 100%; display: flex; align-items: flex-end; justify-content: center; }
.year-bar { width: 24rpx; max-width: 85%; background: #176b55; border-radius: 4rpx 4rpx 0 0; }
.year-month { height: 30rpx; white-space: nowrap; font-size: 20rpx; color: #64716c; }
.year-axis { margin-top: 8rpx; color: #64716c; font-size: 22rpx; text-align: right; }
.retry { margin-top: 24rpx; }
