.form { width: 100%; }
.section-title { font-size: 30rpx; font-weight: 700; }
.hint { color: #7b8882; font-size: 23rpx; font-weight: 400; margin-left: 8rpx; }
.modes, .parts { display: flex; gap: 16rpx; margin-top: 22rpx; }
.parts { flex-wrap: wrap; justify-content: flex-start; }
.mode, .part { flex: 1; min-width: 0; margin: 0; border: 2rpx solid #e5eae6; border-radius: 10rpx; color: #40514a; background: #fff; font-weight: 600; display: flex; align-items: center; justify-content: center; line-height: 1.2; box-sizing: border-box; }
.mode { height: 94rpx; }
.mode.active { background: #e8f4ec; border-color: #176b55; color: #176b55; }
.part-section { margin-top: 40rpx; }
.part { flex: 0 0 auto; width: auto; min-width: 108rpx; max-width: 100%; height: 78rpx; padding: 0 22rpx; font-size: 26rpx; white-space: nowrap; }
.part.legacy { border-style: dashed; }
.part.selected { background: #176b55; border-color: #176b55; color: #fff; }
.button-primary { background: #176b55; color: #fff; border-radius: 10rpx; font-weight: 600; }
.button-primary.is-disabled { background: #94afa5; color: #fff; }
.save { width: 380rpx; max-width: 100%; margin: 46rpx auto 0; height: 92rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; line-height: 1.2; }
.remove { width: 380rpx; max-width: 100%; min-height: 68rpx; margin: 12rpx auto 0; padding: 0; display: flex; align-items: center; justify-content: center; box-sizing: border-box; line-height: 1.2; background: transparent; color: #a94b33; font-size: 25rpx; }
